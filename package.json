{
  "name": "samrajya",
  "private": true,
  "version": "0.1.0",
  "description": "SAMRAJYA: Echoes of Bharat - browser (WebGL2) open-world strategy-action game prototype",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.cjs",
    "build:single": "vite build --mode single",
    "assets": "node tools/assets/build.mjs",
    "assets:check": "node tools/assets/build.mjs --check"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@pmndrs/assets": "1.7.0",
    "@types/node": "22.20.5",
    "@types/three": "0.170.0",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.5",
    "typescript": "~5.6.3",
    "vite": "~5.4.21",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "~2.1.9"
  }
}
